            </div>
            <p style="color: var(--admin-text-secondary); margin-bottom: 1.5rem; font-size: 0.95rem;">
              Selamat datang di Panel Admin CMS Portofolio <strong>${p.name || 'Nurul Ngaeni'}</strong>. Kelola seluruh konten publik website tanpa perlu menyunting kode sumber secara manual.
            </p>
            <div class="grid-4">
              <div class="item-row-card" style="text-align: center;">
                <div style="font-size: 2rem; font-family: var(--admin-font-heading); font-weight: 800; color: var(--admin-accent-gold);">
                  ${workingContent.gallery?.length || 0}
                </div>
                <div style="font-size: 0.85rem; color: var(--admin-text-secondary); font-weight: 600;">Foto Dokumentasi</div>
              </div>
              <div class="item-row-card" style="text-align: center;">
                <div style="font-size: 2rem; font-family: var(--admin-font-heading); font-weight: 800; color: var(--admin-accent-gold);">
                  ${workingContent.services?.length || 0}
                </div>
                <div style="font-size: 0.85rem; color: var(--admin-text-secondary); font-weight: 600;">Layanan Kompetensi</div>
              </div>
              <div class="item-row-card" style="text-align: center;">
                <div style="font-size: 2rem; font-family: var(--admin-font-heading); font-weight: 800; color: var(--admin-accent-gold);">
                  ${workingContent.achievements?.length || 0}
                </div>
                <div style="font-size: 0.85rem; color: var(--admin-text-secondary); font-weight: 600;">Prestasi & Apresiasi</div>
              </div>
              <div class="item-row-card" style="text-align: center;">
                <div style="font-size: 2rem; font-family: var(--admin-font-heading); font-weight: 800; color: var(--admin-accent-gold);">
                  ${workingContent.partners?.items?.length || 0}
                </div>
                <div style="font-size: 0.85rem; color: var(--admin-text-secondary); font-weight: 600;">Mitra Kolaborasi</div>
