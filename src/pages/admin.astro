    <!-- Toast Notification Stack -->
    <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

    <!-- Initial Data Payload Embedded from Server -->
    <script type="application/json" id="initial-cms-payload" set:html={initialDataJson}></script>

    <!-- ==========================================
         3. LOGIKA JAVASCRIPT CMS ADMIN (NATIVE ASTRO)
         ========================================== -->
    <script>
      // State Management
      let defaultServerContent: any = {};
      let workingContent: any = null;
      let activeSection = 'overview';
      let isDirty = false;
      let isLocalDevServer = false;
      let pendingImageCallback: ((path: string) => void) | null = null;

      // Storage Keys
      const STORAGE_DATA_KEY = 'nurul_cms_draft_data';
      const STORAGE_AUTH_KEY = 'nurul_cms_creds';
      const STORAGE_RATE_KEY = 'nurul_cms_rate_limit';
      const SESSION_AUTH_KEY = 'nurul_admin_session';
      const SESSION_TTL_MS = 4 * 60 * 60 * 1000; // 4 Hours

      // Default Admin Credentials (SHA-256 of 'admin123')
      const DEFAULT_USERNAME = 'admin';
      const DEFAULT_PASS_HASH = '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9';

      // Cryptographic SHA-256
      async function sha256Hex(plain: string): Promise<string> {
        const enc = new TextEncoder();
        const hashBuf = await crypto.subtle.digest('SHA-256', enc.encode(plain));
        return Array.from(new Uint8Array(hashBuf))
          .map(b => b.toString(16).padStart(2, '0'))
          .join('');
      }

      function getStoredCredentials(): { username: string; passwordHash: string } {
        const raw = localStorage.getItem(STORAGE_AUTH_KEY);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if (parsed.username && parsed.passwordHash) return parsed;
          } catch {}
        }
        return { username: DEFAULT_USERNAME, passwordHash: DEFAULT_PASS_HASH };
      }

      function isSessionAuthenticated(): boolean {
        const raw = sessionStorage.getItem(SESSION_AUTH_KEY);
        if (!raw) return false;
        try {
          const s = JSON.parse(raw);
          if (!s || !s.authenticated || !s.username || !s.loginAt) return false;
          if (Date.now() - Number(s.loginAt) > SESSION_TTL_MS) {
            sessionStorage.removeItem(SESSION_AUTH_KEY);
            return false;
          }
          return true;
        } catch {
          return false;
        }
      }

      function setSessionAuthenticated(username: string) {
        sessionStorage.setItem(
          SESSION_AUTH_KEY,
          JSON.stringify({ authenticated: true, username, loginAt: Date.now() })
        );
        const userLabel = document.getElementById('active-user-label');
        const userInit = document.getElementById('active-user-initial');
        if (userLabel) userLabel.textContent = username;
        if (userInit) userInit.textContent = username.charAt(0).toUpperCase();
      }

      function showToast(message: string, type: 'success' | 'error' = 'success') {
        const stack = document.getElementById('toast-stack');
        if (!stack) return;
        const toast = document.createElement('div');
        toast.className = `toast-msg ${type}`;
        toast.innerHTML = `
          <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'}"></i>
          <span>${message}</span>
        `;
        stack.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(() => toast.remove(), 250);
        }, 3500);
      }

      function markDirty() {
        isDirty = true;
        const status = document.getElementById('dirty-status');
        const text = document.getElementById('dirty-status-text');
        if (status && text) {
          status.classList.add('unsaved');
          text.textContent = 'Perubahan belum disimpan';
        }
        localStorage.setItem(STORAGE_DATA_KEY, JSON.stringify(workingContent));
      }

      function markClean() {
        isDirty = false;
        const status = document.getElementById('dirty-status');
        const text = document.getElementById('dirty-status-text');
        if (status && text) {
          status.classList.remove('unsaved');
          text.textContent = 'Semua perubahan tersimpan';
        }
      }

      function updateSidebarCounts() {
        if (!workingContent) return;
        const setVal = (id: string, count: number) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(count || 0);
        };
        setVal('count-about-cards', workingContent.about?.cards?.length);
        setVal('count-stats', workingContent.stats?.length);
        setVal('count-partners', workingContent.partners?.items?.length);
        setVal('count-services', workingContent.services?.length);
        setVal('count-gallery', workingContent.gallery?.length);
        setVal('count-projects', workingContent.projects?.length);
        setVal('count-achievements', workingContent.achievements?.length);
        setVal('count-values', workingContent.values?.length);
      }

      function resolveImgSrc(path: string): string {
        if (!path) return '';
        if (path.startsWith('http') || path.startsWith('data:') || path.startsWith('blob:')) {
          return path;
        }
        const base = document.querySelector('link[rel="icon"]')?.getAttribute('href')?.replace(/favicon\.svg$/, '') || '/';
        const cleanPath = path.replace(/^\/+/, '');
        return `${base}${cleanPath}`;
      }

      // Reorder Array Helper
      function moveArrayItem<T>(arr: T[], fromIndex: number, toIndex: number): void {
        if (toIndex < 0 || toIndex >= arr.length) return;
        const item = arr.splice(fromIndex, 1)[0];
        arr.splice(toIndex, 0, item);
      }

      // Check Environment Mode
      async function checkEnvironmentMode() {
        const badge = document.getElementById('env-mode-badge');
        try {
          const res = await fetch('/__admin_api/ping', { method: 'GET' });
          if (res.ok) {
            isLocalDevServer = true;
            if (badge) {
              badge.className = 'mode-badge mode-local';
              badge.innerHTML = '<i class="bi bi-hdd-network"></i><span>Pengembangan Lokal (Astro Dev)</span>';
            }
            return;
          }
        } catch {}
        isLocalDevServer = false;
        if (badge) {
          badge.className = 'mode-badge mode-remote';
          badge.innerHTML = '<i class="bi bi-cloud-check"></i><span>GitHub Pages Production</span>';
        }
      }

      // Load Content
      function loadWorkingContent() {
        const payloadScript = document.getElementById('initial-cms-payload');
        if (payloadScript) {
          try {
            defaultServerContent = JSON.parse(payloadScript.textContent || '{}');
          } catch (e) {
            console.error('Gagal membaca initial payload', e);
          }
        }

        const draft = localStorage.getItem(STORAGE_DATA_KEY);
        if (draft) {
          try {
            workingContent = JSON.parse(draft);
            markDirty();
          } catch {
            workingContent = JSON.parse(JSON.stringify(defaultServerContent));
          }
        } else {
          workingContent = JSON.parse(JSON.stringify(defaultServerContent));
        }
        updateSidebarCounts();
      }

      // Save Changes
      async function saveAllChanges() {
        const saveBtn = document.getElementById('save-all-btn') as HTMLButtonElement | null;
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i><span>Menyimpan...</span>';
        }

        try {
          localStorage.setItem(STORAGE_DATA_KEY, JSON.stringify(workingContent));
          const messages: string[] = ['Browser Cache'];

          if (isLocalDevServer) {
            const res = await fetch('/__admin_api/save', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-cms-request': 'nurul-admin-v1'
              },
              body: JSON.stringify(workingContent)
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Gagal menyimpan ke server lokal');
            }
            messages.push('File Lokal (src/data/portfolioContent.json)');
          } else {
            // Production: GitHub PAT or Download
            const pat = localStorage.getItem('nurul_cms_github_pat');
            const repo = localStorage.getItem('nurul_cms_github_repo') || 'ngaeninurul74-cell/portofolio-nurul-ngaeni';
            if (pat) {
              await pushToGitHub(pat, repo);
              messages.push(`GitHub Repo (${repo})`);
            } else {
              downloadJsonBackup();
              messages.push('Unduhan File JSON');
            }
          }

          localStorage.removeItem(STORAGE_DATA_KEY);
          markClean();
          showToast(`Perubahan berhasil disimpan ke: ${messages.join(' + ')}!`, 'success');
        } catch (err: any) {
          showToast(`Gagal menyimpan: ${err?.message || err}`, 'error');
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-cloud-arrow-up"></i><span>Simpan Perubahan</span>';
          }
        }
      }

      // GitHub Push
      async function pushToGitHub(pat: string, repo: string) {
        const path = 'src/data/portfolioContent.json';
        const contentStr = JSON.stringify(workingContent, null, 2) + '\n';
        const base64Content = btoa(unescape(encodeURIComponent(contentStr)));

        const getUrl = `https://api.github.com/repos/${repo}/contents/${path}`;
        const getRes = await fetch(getUrl, {
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Accept': 'application/vnd.github.v3+json'
          }
        });

        let sha: string | undefined = undefined;
        if (getRes.ok) {
          const fileData = await getRes.json();
          sha = fileData.sha;
        }

        const putRes = await fetch(getUrl, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Content-Type': 'application/json',
            'Accept': 'application/vnd.github.v3+json'
          },
          body: JSON.stringify({
            message: 'chore(cms): update portfolio content via Admin Panel',
            content: base64Content,
            sha: sha || undefined
          })
        });

        if (!putRes.ok) {
          const errData = await putRes.json();
          throw new Error(errData.message || 'Gagal commit ke GitHub');
        }
      }

      // Factory Reset to Default
      async function resetToDefaultContent() {
        const confirmed = confirm(
          'Apakah Anda yakin ingin mengembalikan seluruh konten ke data default bawaan pabrik?\n\n' +
          '• Semua editan yang belum disimpan atau tersimpan di browser akan dikembalikan ke awal.\n' +
          '• File data di server lokal juga akan diselaraskan kembali ke konten default.\n\n' +
          'Klik OK untuk melanjutkan reset.'
        );
        if (!confirmed) return;

        localStorage.removeItem(STORAGE_DATA_KEY);
        workingContent = JSON.parse(JSON.stringify(defaultServerContent));

        if (isLocalDevServer) {
          try {
            await fetch('/__admin_api/save', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-cms-request': 'nurul-admin-v1'
              },
              body: JSON.stringify(defaultServerContent)
            });
          } catch {}
        }

        updateSidebarCounts();
        markClean();
        renderActiveSection();
        showToast('Seluruh konten berhasil di-reset ke kondisi default bawaan.', 'success');
      }

      function downloadJsonBackup() {
        const blob = new Blob([JSON.stringify(workingContent, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'portfolioContent.json';
        a.click();
        URL.revokeObjectURL(url);
      }

      // Canvas Rasterization & Safe Upload
      function triggerImageUpload(folder: string, callback: (path: string) => void) {
        pendingImageCallback = callback;
        const fileInput = document.getElementById('cms-file-input') as HTMLInputElement | null;
        if (!fileInput) return;
        fileInput.value = '';

        fileInput.onchange = async () => {
          const file = fileInput.files?.[0];
          if (!file || !pendingImageCallback) return;

          const allowedMimes = ['image/jpeg', 'image/png', 'image/webp'];
          if (!allowedMimes.includes(file.type)) {
            showToast('Tipe file ditolak: hanya menerima JPG, PNG, atau WebP!', 'error');
            return;
          }
          if (file.size > 5 * 1024 * 1024) {
            showToast('Ukuran foto terlalu besar (maksimal 5 MB)!', 'error');
            return;
          }

          try {
            // Anti-webshell canvas rasterization
            const img = new Image();
            const objectUrl = URL.createObjectURL(file);
            await new Promise((resolve, reject) => {
              img.onload = resolve;
              img.onerror = reject;
              img.src = objectUrl;
            });

            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            if (!ctx) throw new Error('Gagal memproses gambar pada kanvas');
            ctx.drawImage(img, 0, 0);
            URL.revokeObjectURL(objectUrl);

            const base64Data = canvas.toDataURL('image/webp', 0.92);
            const safeName = file.name.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase() + '.webp';

            if (isLocalDevServer) {
              const res = await fetch('/__admin_api/upload', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'x-cms-request': 'nurul-admin-v1'
                },
                body: JSON.stringify({
                  filename: safeName,
                  base64Data,
                  folder: folder || 'landing_page_assets/gallery'
                })
              });
              const resData = await res.json();
              if (!res.ok || !resData.ok) {
                throw new Error(resData.error || 'Upload gagal');
              }
              pendingImageCallback(resData.path);
              showToast(`Foto berhasil diunggah ke public/${resData.path}!`, 'success');
            } else {
              pendingImageCallback(base64Data);
              showToast('Foto diproses sebagai WebP raster mandiri!', 'success');
            }
            markDirty();
            renderActiveSection();
          } catch (err: any) {
            showToast(`Gagal memproses foto: ${err?.message || err}`, 'error');
          }
        };
        fileInput.click();
      }

      // ==========================================
      // UI FIELD BUILDER HELPERS
      // ==========================================
      function createInputField(
        label: string,
        value: string,
        onChange: (val: string) => void,
        options?: { placeholder?: string; type?: string; fullWidth?: boolean; hint?: string }
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = `field-group${options?.fullWidth ? ' col-span-full' : ''}`;
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;
        const input = document.createElement('input');
        input.type = options?.type || 'text';
        input.className = 'field-input';
        input.value = value || '';
        if (options?.placeholder) input.placeholder = options.placeholder;
        input.addEventListener('input', () => {
          onChange(input.value);
          markDirty();
        });
        wrap.appendChild(lbl);
        wrap.appendChild(input);
        if (options?.hint) {
          const hint = document.createElement('span');
          hint.className = 'field-hint';
          hint.textContent = options.hint;
          wrap.appendChild(hint);
        }
        return wrap;
      }

      function createIconInputField(
        label: string,
        value: string,
        onChange: (val: string) => void,
        placeholder = 'mis. bi bi-mic-fill'
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = 'field-group';
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;

        const row = document.createElement('div');
        row.className = 'icon-input-row';

        const previewBox = document.createElement('div');
        previewBox.className = 'icon-preview-box';
        const iconEl = document.createElement('i');
        iconEl.className = value || 'bi bi-star-fill';
        previewBox.appendChild(iconEl);

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'field-input';
        input.value = value || '';
        input.placeholder = placeholder;
        input.addEventListener('input', () => {
          onChange(input.value);
          iconEl.className = input.value.trim() || 'bi bi-star-fill';
          markDirty();
        });

        row.append(previewBox, input);
        wrap.append(lbl, row);
        return wrap;
      }

      function createTextareaField(
        label: string,
        value: string,
        onChange: (val: string) => void,
        options?: { rows?: number; fullWidth?: boolean; hint?: string }
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = `field-group${options?.fullWidth !== false ? ' col-span-full' : ''}`;
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;
        const textarea = document.createElement('textarea');
        textarea.className = 'field-textarea';
        if (options?.rows) textarea.rows = options.rows;
        textarea.value = value || '';
        textarea.addEventListener('input', () => {
          onChange(textarea.value);
          markDirty();
        });
        wrap.appendChild(lbl);
        wrap.appendChild(textarea);
        if (options?.hint) {
          const hint = document.createElement('span');
          hint.className = 'field-hint';
          hint.textContent = options.hint;
          wrap.appendChild(hint);
        }
        return wrap;
      }

      function createSelectField(
        label: string,
        value: string,
        options: { value: string; label: string }[],
        onChange: (val: string) => void
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = 'field-group';
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;
        const sel = document.createElement('select');
        sel.className = 'field-select';
        options.forEach(opt => {
          const o = document.createElement('option');
          o.value = opt.value;
          o.textContent = opt.label;
          if (opt.value === value) o.selected = true;
          sel.appendChild(o);
        });
        sel.addEventListener('change', () => {
          onChange(sel.value);
          markDirty();
        });
        wrap.append(lbl, sel);
        return wrap;
      }

      function createPhotoRow(
        currentPath: string,
        onUploadTrigger: () => void,
        titleLabel = 'Foto Pratinjau'
      ): HTMLElement {
        const row = document.createElement('div');
        row.className = 'photo-preview-row';
        const img = document.createElement('img');
        img.className = 'thumb-preview';
        img.src = resolveImgSrc(currentPath);
        img.alt = titleLabel;

        const meta = document.createElement('div');
        meta.className = 'photo-meta-box';
        const lbl = document.createElement('div');
        lbl.className = 'photo-meta-label';
        lbl.textContent = titleLabel;
        const pathEl = document.createElement('div');
        pathEl.className = 'photo-meta-path';
        pathEl.textContent = currentPath || 'Belum ada foto yang dipilih';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-secondary';
        btn.innerHTML = '<i class="bi bi-camera"></i> <span>Ganti &amp; Unggah Foto</span>';
        btn.addEventListener('click', onUploadTrigger);

        meta.append(lbl, pathEl, btn);
        row.append(img, meta);
        return row;
      }

      function createRepeaterCard(params: {
        index: number;
        total: number;
        title: string;
        badgeText?: string;
        onMoveUp?: () => void;
        onMoveDown?: () => void;
        onDelete: () => void;
        bodyElements: HTMLElement[];
      }): HTMLElement {
        const card = document.createElement('div');
        card.className = 'repeater-card';

        const top = document.createElement('div');
        top.className = 'repeater-top';

        const titleBox = document.createElement('div');
        titleBox.className = 'repeater-title-box';
        if (params.badgeText) {
          const badge = document.createElement('span');
          badge.className = 'item-badge-pill';
          badge.textContent = params.badgeText;
          titleBox.appendChild(badge);
        }
        const titleEl = document.createElement('span');
        titleEl.className = 'repeater-title';
        titleEl.textContent = params.title;
        titleBox.appendChild(titleEl);

        const actions = document.createElement('div');
        actions.className = 'repeater-actions';

        if (params.onMoveUp) {
          const upBtn = document.createElement('button');
          upBtn.type = 'button';
          upBtn.className = 'btn-reorder';
          upBtn.title = 'Pindah ke atas';
          upBtn.innerHTML = '<i class="bi bi-arrow-up"></i>';
          upBtn.disabled = params.index === 0;
          upBtn.addEventListener('click', params.onMoveUp);
          actions.appendChild(upBtn);
        }

        if (params.onMoveDown) {
          const downBtn = document.createElement('button');
          downBtn.type = 'button';
          downBtn.className = 'btn-reorder';
          downBtn.title = 'Pindah ke bawah';
          downBtn.innerHTML = '<i class="bi bi-arrow-down"></i>';
          downBtn.disabled = params.index === params.total - 1;
          downBtn.addEventListener('click', params.onMoveDown);
          actions.appendChild(downBtn);
        }

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-danger-plain';
        delBtn.title = 'Hapus item ini';
        delBtn.innerHTML = '<i class="bi bi-trash3"></i> <span>Hapus</span>';
        delBtn.addEventListener('click', params.onDelete);
        actions.appendChild(delBtn);

        top.append(titleBox, actions);
        card.appendChild(top);

        params.bodyElements.forEach(el => card.appendChild(el));
        return card;
      }

      function createChecklistManager(checklist: string[], onChange: () => void): HTMLElement {
        const card = document.createElement('div');
        card.className = 'checklist-card col-span-full';

        const top = document.createElement('div');
        top.className = 'checklist-top';
        const lbl = document.createElement('div');
        lbl.className = 'checklist-label';
        lbl.innerHTML = `<i class="bi bi-check2-square"></i> Poin Checklist (${checklist.length})`;
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn-secondary';
        addBtn.style.padding = '0.35rem 0.75rem';
        addBtn.style.fontSize = '0.78rem';
        addBtn.innerHTML = '<i class="bi bi-plus-lg"></i> Tambah Poin';
        addBtn.addEventListener('click', () => {
          checklist.push('Poin baru...');
          onChange();
          markDirty();
          renderActiveSection();
        });
        top.append(lbl, addBtn);
        card.appendChild(top);

        const stack = document.createElement('div');
        stack.className = 'checklist-stack';
        checklist.forEach((item, bIdx) => {
          const row = document.createElement('div');
          row.className = 'checklist-item-row';
          const dot = document.createElement('i');
          dot.className = 'bi bi-check-circle-fill';
          dot.style.color = 'var(--admin-gold)';
          dot.style.fontSize = '0.85rem';

          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'field-input';
          input.style.padding = '0.45rem 0.75rem';
          input.style.fontSize = '0.85rem';
          input.value = item;
          input.addEventListener('input', () => {
            checklist[bIdx] = input.value;
            onChange();
            markDirty();
          });

          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn-danger-plain';
          delBtn.style.padding = '0.45rem 0.65rem';
          delBtn.innerHTML = '<i class="bi bi-trash3"></i>';
          delBtn.title = 'Hapus poin';
          delBtn.addEventListener('click', () => {
            checklist.splice(bIdx, 1);
            onChange();
            markDirty();
            renderActiveSection();
          });

          row.append(dot, input, delBtn);
          stack.appendChild(row);
        });
        card.appendChild(stack);
        return card;
      }

