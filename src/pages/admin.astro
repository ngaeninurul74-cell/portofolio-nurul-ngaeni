---
// src/pages/admin.astro
// Panel Admin CMS Portofolio Nurul Ngaeni (Full CRUD & Reorder, Security-Hardened)
import rawPortfolioContent from '../data/portfolioContent.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const initialDataJson = JSON.stringify(rawPortfolioContent);
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <title>Admin CMS | Portofolio Nurul Ngaeni</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <style is:global>
      :root {
        --admin-bg-base: #090d16;
        --admin-bg-surface: #101726;
        --admin-bg-card: #151f33;
        --admin-bg-input: #0b111e;
        --admin-border-subtle: rgba(255, 255, 255, 0.08);
        --admin-border-strong: rgba(255, 255, 255, 0.16);
        --admin-border-focus: #f59e0b;
        --admin-text-primary: #f8fafc;
        --admin-text-secondary: #94a3b8;
        --admin-text-muted: #64748b;
        --admin-gold: #f59e0b;
        --admin-gold-hover: #d97706;
        --admin-gold-soft: rgba(245, 158, 11, 0.12);
        --admin-success: #10b981;
        --admin-success-soft: rgba(16, 185, 129, 0.12);
        --admin-danger: #ef4444;
        --admin-danger-soft: rgba(239, 68, 68, 0.12);
        --admin-font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
        --admin-font-heading: 'Poppins', system-ui, sans-serif;
        --admin-sidebar-width: 270px;
        --admin-header-height: 64px;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--admin-font-body);
        background: var(--admin-bg-base);
        color: var(--admin-text-primary);
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      [hidden] {
        display: none !important;
      }

      /* Login Screen */
      .login-screen {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
        background: radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 60%), var(--admin-bg-base);
      }

      .login-sheet {
        width: 100%;
        max-width: 440px;
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }

      .login-brand-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
      }

      .brand-monogram {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--admin-gold), var(--admin-gold-hover));
        color: #000;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--admin-font-heading);
        font-weight: 800;
        font-size: 1.35rem;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
      }

      .brand-meta {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-family: var(--admin-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--admin-text-primary);
        letter-spacing: -0.02em;
      }

      .brand-scope {
        font-size: 0.78rem;
        color: var(--admin-gold);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .login-title {
        font-family: var(--admin-font-heading);
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--admin-text-primary);
      }

      .login-desc {
        color: var(--admin-text-secondary);
        font-size: 0.88rem;
        margin-bottom: 1.75rem;
        line-height: 1.5;
      }

      .alert-box {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.84rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .alert-error {
        background: var(--admin-danger-soft);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      /* Form Fields */
      .field-group {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-bottom: 1.1rem;
      }

      .col-span-full {
        grid-column: 1 / -1;
      }

      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .field-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--admin-text-secondary);
        letter-spacing: 0.01em;
      }

      .field-input,
      .field-textarea,
      .field-select {
        background: var(--admin-bg-input);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 8px;
        color: var(--admin-text-primary);
        font-family: var(--admin-font-body);
        font-size: 0.9rem;
        padding: 0.65rem 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        width: 100%;
      }

      .field-input:focus,
      .field-textarea:focus,
      .field-select:focus {
        outline: none;
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
      }

      .field-textarea {
        resize: vertical;
        min-height: 90px;
        line-height: 1.6;
      }

      .field-hint {
        font-size: 0.75rem;
        color: var(--admin-text-muted);
        line-height: 1.4;
      }

      .text-action-btn {
        background: none;
        border: none;
        color: var(--admin-gold);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
      }

      .text-action-btn:hover {
        text-decoration: underline;
      }

      /* Buttons */
      .btn-primary {
        background: linear-gradient(135deg, var(--admin-gold), var(--admin-gold-hover));
        color: #0b111c;
        border: none;
        border-radius: 8px;
        font-family: var(--admin-font-body);
        font-weight: 700;
        font-size: 0.88rem;
        padding: 0.65rem 1.25rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: transform 0.1s ease, box-shadow 0.15s ease, filter 0.15s ease;
        text-decoration: none;
      }

      .btn-primary:hover:not(:disabled) {
        filter: brightness(1.08);
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
      }

      .btn-primary:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .btn-primary.btn-block {
        width: 100%;
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: var(--admin-text-primary);
        border: 1px solid var(--admin-border-strong);
        border-radius: 8px;
        font-family: var(--admin-font-body);
        font-weight: 600;
        font-size: 0.84rem;
        padding: 0.55rem 1rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        transition: background 0.15s ease, border-color 0.15s ease;
        text-decoration: none;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.25);
      }

      .btn-danger-plain {
        background: var(--admin-danger-soft);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 6px;
        font-family: var(--admin-font-body);
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.38rem 0.75rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: background 0.15s ease;
      }

      .btn-danger-plain:hover {
        background: rgba(239, 68, 68, 0.22);
      }

      .btn-reorder {
        background: rgba(255, 255, 255, 0.06);
        color: var(--admin-text-secondary);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 6px;
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .btn-reorder:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.14);
        color: var(--admin-text-primary);
        border-color: var(--admin-border-strong);
      }

      .btn-reorder:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      /* Admin Shell Layout */
      .admin-layout {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar */
      .admin-sidebar {
        width: var(--admin-sidebar-width);
        background: var(--admin-bg-surface);
        border-right: 1px solid var(--admin-border-subtle);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
      }

      .sidebar-brand-box {
        padding: 1.35rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        border-bottom: 1px solid var(--admin-border-subtle);
      }

      .sidebar-nav {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .nav-group-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--admin-text-muted);
        padding: 0.85rem 0.65rem 0.35rem;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.62rem 0.85rem;
        border-radius: 8px;
        color: var(--admin-text-secondary);
        font-size: 0.86rem;
        font-weight: 500;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
        text-align: left;
        width: 100%;
      }

      .nav-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--admin-text-primary);
      }

      .nav-item.active {
        background: var(--admin-gold-soft);
        color: var(--admin-gold);
        font-weight: 700;
      }

      .nav-count {
        margin-left: auto;
        font-size: 0.72rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.08);
        color: var(--admin-text-secondary);
        padding: 0.12rem 0.5rem;
        border-radius: 999px;
      }

      .nav-item.active .nav-count {
        background: var(--admin-gold);
        color: #0b111c;
      }

      .sidebar-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--admin-border-subtle);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--admin-bg-card);
        color: var(--admin-gold);
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        border: 1px solid var(--admin-border-subtle);
      }

      .user-name {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--admin-text-primary);
        display: block;
      }

      .user-role {
        font-size: 0.7rem;
        color: var(--admin-text-muted);
        display: block;
      }

      .btn-logout {
        background: transparent;
        border: 1px solid var(--admin-border-subtle);
        color: var(--admin-text-secondary);
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .btn-logout:hover {
        background: var(--admin-danger-soft);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.4);
      }

      /* Main Workspace */
      .admin-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: var(--admin-bg-base);
      }

      .admin-header {
        height: var(--admin-header-height);
        background: var(--admin-bg-surface);
        border-bottom: 1px solid var(--admin-border-subtle);
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .header-title-box {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .section-heading-title {
        font-family: var(--admin-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--admin-text-primary);
      }

      .mode-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .mode-local {
        background: var(--admin-success-soft);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
      }

      .mode-remote {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.3);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .dirty-indicator {
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--admin-text-muted);
      }

      .dirty-indicator.unsaved {
        color: var(--admin-gold);
      }

      .dirty-indicator .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--admin-text-muted);
      }

      .dirty-indicator.unsaved .pulse-dot {
        background: var(--admin-gold);
        box-shadow: 0 0 8px rgba(245, 158, 11, 0.8);
      }

      .admin-content {
        padding: 2.25rem;
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
        flex: 1;
      }

      /* Panel Cards */
      .cms-panel {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 14px;
        padding: 1.75rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      }

      .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--admin-border-subtle);
        flex-wrap: wrap;
      }

      .panel-title {
        font-family: var(--admin-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--admin-text-primary);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .panel-desc {
        color: var(--admin-text-secondary);
        font-size: 0.85rem;
        margin-top: 0.25rem;
        line-height: 1.5;
      }

      /* KPI Strip */
      .kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
      }

      @media (max-width: 900px) {
        .kpi-strip {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .kpi-cell {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
      }

      .kpi-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--admin-text-secondary);
      }

      .kpi-value {
        font-family: var(--admin-font-heading);
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--admin-gold);
        margin: 0.35rem 0 0.15rem;
      }

      .kpi-note {
        font-size: 0.72rem;
        color: var(--admin-text-muted);
      }

      /* Repeater Cards */
      .item-list-stack {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .repeater-card {
        background: var(--admin-bg-card);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 12px;
        padding: 1.35rem;
        transition: border-color 0.15s ease;
      }

      .repeater-card:hover {
        border-color: var(--admin-border-strong);
      }

      .repeater-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.15rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .repeater-title-box {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 0;
      }

      .item-badge-pill {
        background: var(--admin-gold-soft);
        color: var(--admin-gold);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        white-space: nowrap;
      }

      .repeater-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--admin-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .repeater-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
      }

      /* Grids */
      .form-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .form-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      @media (max-width: 768px) {
        .form-grid-2,
        .form-grid-3 {
          grid-template-columns: 1fr;
        }
      }

      /* Live Icon Input Preview Box */
      .icon-input-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .icon-preview-box {
        width: 40px;
        height: 40px;
        background: var(--admin-bg-base);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        color: var(--admin-gold);
        flex-shrink: 0;
      }

      /* Photo Upload Row */
      .photo-preview-row {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1rem;
        background: var(--admin-bg-base);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 10px;
        margin-bottom: 1.1rem;
      }

      .thumb-preview {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid var(--admin-border-strong);
        background: #000;
        flex-shrink: 0;
      }

      .photo-meta-box {
        flex: 1;
        min-width: 0;
      }

      .photo-meta-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--admin-text-primary);
        margin-bottom: 0.2rem;
      }

      .photo-meta-path {
        font-size: 0.75rem;
        color: var(--admin-text-muted);
        font-family: monospace;
        word-break: break-all;
        margin-bottom: 0.6rem;
      }

      /* Checklist Manager */
      .checklist-card {
        background: var(--admin-bg-base);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 10px;
        padding: 1rem;
        margin-top: 0.5rem;
      }

      .checklist-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .checklist-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--admin-text-secondary);
      }

      .checklist-stack {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .checklist-item-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Data Table */
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
      }

      .data-table th,
      .data-table td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--admin-border-subtle);
        text-align: left;
      }

      .data-table th {
        font-weight: 700;
        color: var(--admin-text-muted);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: rgba(255, 255, 255, 0.02);
      }

      .data-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
      }

      .num-col {
        text-align: right !important;
      }

      /* Toast Stack */
      .toast-stack {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        z-index: 9999;
        pointer-events: none;
      }

      .toast-msg {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-strong);
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        transition: opacity 0.25s ease, transform 0.25s ease;
        pointer-events: auto;
        color: var(--admin-text-primary);
      }

      .toast-msg.success {
        border-color: rgba(16, 185, 129, 0.4);
        background: #064e3b;
        color: #d1fae5;
      }

      .toast-msg.error {
        border-color: rgba(239, 68, 68, 0.4);
        background: #7f1d1d;
        color: #fee2e2;
      }
    </style>
  </head>
