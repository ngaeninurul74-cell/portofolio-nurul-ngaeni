    <!-- Hidden File Input for Image Uploads -->
    <input type="file" id="cms-file-input" accept="image/jpeg,image/png,image/webp" style="display: none;" />

    <!-- Toast Notifications Stack -->
    <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

    <!-- ==========================================
         3. LOGIKA JAVASCRIPT PANEL ADMIN
         ========================================== -->
    <script>
      // State Management
      let initialData = {};
      let workingContent = null;
      let activeSection = 'overview';
      let isDirty = false;
      let isLocalDev = false;
      let currentUploadCallback = null;

      // SHA-256 Helper
      async function sha256Hex(plain) {
        const enc = new TextEncoder();
        const hashBuf = await crypto.subtle.digest('SHA-256', enc.encode(plain));
        return Array.from(new Uint8Array(hashBuf))
          .map(b => b.toString(16).padStart(2, '0'))
          .join('');
      }

      // Default Admin Credentials Hash
      // Default: admin / admin123 -> SHA-256 of 'admin123'
      const DEFAULT_PASS_HASH = '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9';
      const DEFAULT_USER = 'admin';

      function getStoredCredentials() {
        const user = localStorage.getItem('nurul_cms_user') || DEFAULT_USER;
        const passHash = localStorage.getItem('nurul_cms_pass_hash') || DEFAULT_PASS_HASH;
        return { user, passHash };
      }

      // Toast Notifications
      function showToast(message, type = 'success') {
        const stack = document.getElementById('toast-stack');
        if (!stack) return;
        const toast = document.createElement('div');
        toast.className = `toast-msg ${type}`;
        toast.innerHTML = `
          <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'}"></i>
          <span>${message}</span>
        `;
        stack.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(() => toast.remove(), 250);
        }, 3500);
      }

      function markDirty() {
        isDirty = true;
        const status = document.getElementById('dirty-status');
        const text = document.getElementById('dirty-status-text');
        if (status && text) {
          status.classList.add('unsaved');
          text.textContent = 'Perubahan belum disimpan';
        }
      }

      function markClean() {
        isDirty = false;
        const status = document.getElementById('dirty-status');
        const text = document.getElementById('dirty-status-text');
        if (status && text) {
          status.classList.remove('unsaved');
          text.textContent = 'Semua perubahan tersimpan';
        }
      }

      // Check Environment Mode
      async function checkEnvironmentMode() {
        const badge = document.getElementById('env-mode-badge');
        try {
          const res = await fetch('/__admin_api/ping', { method: 'GET' });
          if (res.ok) {
            isLocalDev = true;
            if (badge) {
              badge.className = 'mode-badge mode-local';
              badge.innerHTML = '<i class="bi bi-hdd-network"></i><span>Mode: Pengembangan Lokal (Astro Dev)</span>';
            }
            return;
          }
        } catch {
          // fetch failed, running in production
        }
        isLocalDev = false;
        if (badge) {
          badge.className = 'mode-badge mode-remote';
          badge.innerHTML = '<i class="bi bi-cloud-check"></i><span>Mode: GitHub Pages Production</span>';
        }
      }

      // Load Content
      function loadWorkingContent() {
        const scriptPayload = document.getElementById('initial-cms-payload');
        if (scriptPayload) {
          try {
            initialData = JSON.parse(scriptPayload.textContent || '{}');
          } catch (e) {
            console.error('Gagal membaca initial payload', e);
          }
        }

        const draft = localStorage.getItem('nurul_cms_draft_data');
        if (draft) {
          try {
            workingContent = JSON.parse(draft);
            markDirty();
          } catch {
            workingContent = JSON.parse(JSON.stringify(initialData));
          }
        } else {
          workingContent = JSON.parse(JSON.stringify(initialData));
        }
        updateCounts();
      }

      function updateCounts() {
        if (!workingContent) return;
        const setVal = (id, count) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(count || 0);
        };
        setVal('count-stats', workingContent.stats?.length);
        setVal('count-partners', workingContent.partners?.items?.length);
        setVal('count-services', workingContent.services?.length);
        setVal('count-gallery', workingContent.gallery?.length);
        setVal('count-projects', workingContent.projects?.length);
        setVal('count-achievements', workingContent.achievements?.length);
        setVal('count-values', workingContent.values?.length);
      }

      // Save Changes
      async function saveAllChanges() {
        const saveBtn = document.getElementById('save-all-btn');
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i><span>Menyimpan...</span>';
        }

        try {
          if (isLocalDev) {
            // Local dev save
            const res = await fetch('/__admin_api/save', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-cms-request': 'nurul-admin-v1'
              },
              body: JSON.stringify(workingContent)
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Gagal menyimpan ke server lokal');
            }
            localStorage.removeItem('nurul_cms_draft_data');
            markClean();
            showToast('Perubahan berhasil disimpan ke src/data/portfolioContent.json!');
          } else {
            // Remote production save: check GitHub PAT or download JSON
            const pat = localStorage.getItem('nurul_cms_github_pat');
            const repo = localStorage.getItem('nurul_cms_github_repo') || 'ngaeninurul74-cell/portofolio-nurul-ngaeni';
            if (pat) {
              await pushToGitHub(pat, repo);
            } else {
              // Direct download fallback
              downloadJsonBackup();
              showToast('Perubahan diunduh sebagai file portfolioContent.json (mode static)', 'success');
              markClean();
            }
          }
        } catch (err) {
          showToast(`Error: ${err.message}`, 'error');
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-cloud-arrow-up"></i><span>Simpan Perubahan</span>';
          }
        }
      }

      // GitHub Push
      async function pushToGitHub(pat, repo) {
        const path = 'src/data/portfolioContent.json';
        const contentStr = JSON.stringify(workingContent, null, 2) + '\n';
        const base64Content = btoa(unescape(encodeURIComponent(contentStr)));

        // Get file SHA
        const getUrl = `https://api.github.com/repos/${repo}/contents/${path}`;
        const getRes = await fetch(getUrl, {
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Accept': 'application/vnd.github.v3+json'
          }
        });

        let sha = null;
        if (getRes.ok) {
          const fileData = await getRes.json();
          sha = fileData.sha;
        }

        const putRes = await fetch(getUrl, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Content-Type': 'application/json',
            'Accept': 'application/vnd.github.v3+json'
          },
          body: JSON.stringify({
            message: 'chore(cms): update portfolio content via Admin Panel',
            content: base64Content,
            sha: sha || undefined
          })
        });

        if (!putRes.ok) {
          const errData = await putRes.json();
          throw new Error(errData.message || 'Gagal commit ke GitHub');
        }

        localStorage.removeItem('nurul_cms_draft_data');
        markClean();
        showToast('Berhasil commit langsung ke GitHub repository!');
      }

      function downloadJsonBackup() {
        const blob = new Blob([JSON.stringify(workingContent, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'portfolioContent.json';
        a.click();
        URL.revokeObjectURL(url);
      }

      // Canvas Rasterization & Anti-php2shell Upload
      function triggerImageUpload(folder, callback) {
        currentUploadCallback = callback;
        const fileInput = document.getElementById('cms-file-input');
        if (fileInput) {
          fileInput.value = '';
          fileInput.onchange = async () => {
            const file = fileInput.files?.[0];
            if (!file) return;

            // 1. Validate MIME
            const validMimes = ['image/jpeg', 'image/png', 'image/webp'];
            if (!validMimes.includes(file.type)) {
              showToast('Hanya format JPG, PNG, atau WebP yang diizinkan!', 'error');
              return;
            }

            // 2. Validate Size (max 5 MB)
            if (file.size > 5 * 1024 * 1024) {
              showToast('Ukuran foto maksimal 5 MB!', 'error');
              return;
            }

            try {
              // 3. Canvas Rasterization (Eliminates php2shell and malicious code injection)
              const img = new Image();
              const objectUrl = URL.createObjectURL(file);
              await new Promise((resolve, reject) => {
                img.onload = resolve;
                img.onerror = reject;
                img.src = objectUrl;
              });

              const canvas = document.createElement('canvas');
              canvas.width = img.width;
              canvas.height = img.height;
              const ctx = canvas.getContext('2d');
              if (!ctx) throw new Error('Gagal memproses kanvas gambar');
              ctx.drawImage(img, 0, 0);
              URL.revokeObjectURL(objectUrl);

              const base64Data = canvas.toDataURL('image/webp', 0.92);
              const safeFileName = file.name.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase() + '.webp';

              if (isLocalDev) {
                // Upload via API
                const res = await fetch('/__admin_api/upload', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'x-cms-request': 'nurul-admin-v1'
                  },
                  body: JSON.stringify({
                    filename: safeFileName,
                    base64Data: base64Data,
                    folder: folder || 'landing_page_assets/gallery'
                  })
                });
                const resData = await res.json();
                if (!res.ok || !resData.ok) {
                  throw new Error(resData.error || 'Upload gagal');
                }
                showToast('Foto berhasil diunggah dan disimpan!');
                if (currentUploadCallback) currentUploadCallback(resData.path);
              } else {
                // In production, fallback to base64 preview
                showToast('Foto diproses (tersimpan lokal sebagai WebP raster)', 'success');
                if (currentUploadCallback) currentUploadCallback(base64Data);
              }
              markDirty();
              renderActiveSection();
            } catch (err) {
              showToast(`Gagal memproses foto: ${err.message}`, 'error');
            }
          };
          fileInput.click();
        }
      }

      // Section Renderers
      function renderActiveSection() {
        const container = document.getElementById('active-panel-container');
        const titleEl = document.getElementById('current-section-title');
        if (!container || !workingContent) return;

        switch (activeSection) {
          case 'overview':
            if (titleEl) titleEl.textContent = 'Ringkasan Data & Status Sistem';
            container.innerHTML = renderOverview();
            break;
          case 'profile':
            if (titleEl) titleEl.textContent = 'Profil & Hero Utama';
            container.innerHTML = renderProfile();
            break;
          case 'about':
            if (titleEl) titleEl.textContent = 'Tentang Saya & Filosofi';
            container.innerHTML = renderAbout();
            break;
          case 'stats':
            if (titleEl) titleEl.textContent = 'Statistik Dampak (Counter)';
            container.innerHTML = renderStats();
            break;
          case 'partners':
            if (titleEl) titleEl.textContent = 'Mitra & Kolaborasi';
            container.innerHTML = renderPartners();
            break;
          case 'services':
            if (titleEl) titleEl.textContent = 'Layanan & Kompetensi';
            container.innerHTML = renderServices();
            break;
          case 'gallery':
            if (titleEl) titleEl.textContent = 'Galeri Dokumentasi Foto';
            container.innerHTML = renderGallery();
            break;
          case 'projects':
            if (titleEl) titleEl.textContent = 'Proyek & Inisiatif Bisnis';
            container.innerHTML = renderProjects();
            break;
          case 'achievements':
            if (titleEl) titleEl.textContent = 'Prestasi & Apresiasi';
            container.innerHTML = renderAchievements();
            break;
          case 'values':
            if (titleEl) titleEl.textContent = 'Prinsip & Nilai Kerja';
            container.innerHTML = renderValues();
            break;
          case 'contact':
            if (titleEl) titleEl.textContent = 'Kontak & Booking';
            container.innerHTML = renderContact();
            break;
          case 'settings':
            if (titleEl) titleEl.textContent = 'Pengaturan & GitHub Sync';
            container.innerHTML = renderSettings();
            break;
        }
        attachFormListeners();
      }

      // Overview HTML
      function renderOverview() {
