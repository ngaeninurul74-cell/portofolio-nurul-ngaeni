      // Attach Form Listeners
      function attachFormListeners() {
        document.querySelectorAll('[data-bind]').forEach(input => {
          input.addEventListener('input', (e) => {
            const path = (e.target as HTMLElement).getAttribute('data-bind') || '';
            const val = (e.target as HTMLInputElement).value;
            const parts = path.split('.');
            let obj = workingContent;
            for (let i = 0; i < parts.length - 1; i++) {
              if (!obj[parts[i]]) obj[parts[i]] = {};
              obj = obj[parts[i]];
            }
            obj[parts[parts.length - 1]] = val;
            localStorage.setItem('nurul_cms_draft_data', JSON.stringify(workingContent));
            markDirty();
          });
        });

        document.querySelectorAll('[data-array-bind]').forEach(input => {
          input.addEventListener('input', (e) => {
            const path = (e.target as HTMLElement).getAttribute('data-array-bind') || '';
            const val = (e.target as HTMLInputElement).value;
            const parts = path.split('.');
            let obj = workingContent;
            for (let i = 0; i < parts.length - 1; i++) {
              obj = obj[parts[i]];
            }
            obj[parts[parts.length - 1]] = val;
            localStorage.setItem('nurul_cms_draft_data', JSON.stringify(workingContent));
            markDirty();
          });
        });
      }

