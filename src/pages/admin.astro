---
// src/pages/admin.astro
// Panel Admin CMS Portofolio Nurul Ngaeni (Security-Hardened, Astro Native)
import rawPortfolioContent from '../data/portfolioContent.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const initialDataJson = JSON.stringify(rawPortfolioContent);
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <title>Admin CMS | Portofolio Nurul Ngaeni</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <style>
      :root {
        --admin-bg-base: #090d16;
        --admin-bg-surface: #101726;
        --admin-bg-card: #162034;
        --admin-bg-input: #0b111c;
        --admin-border-subtle: rgba(255, 255, 255, 0.08);
        --admin-border-focus: #f59e0b;
        --admin-text-primary: #f8fafc;
        --admin-text-secondary: #94a3b8;
        --admin-text-muted: #64748b;
        --admin-accent-gold: #f59e0b;
        --admin-accent-gold-dark: #d97706;
        --admin-accent-gold-soft: rgba(245, 158, 11, 0.12);
        --admin-success: #10b981;
        --admin-danger: #ef4444;
        --admin-font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
        --admin-font-heading: 'Poppins', system-ui, sans-serif;
        --admin-sidebar-width: 270px;
        --admin-header-height: 64px;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--admin-font-body);
        background: var(--admin-bg-base);
        color: var(--admin-text-primary);
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* Login Screen */
      .login-screen {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
        background: radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 60%), var(--admin-bg-base);
      }

      .login-sheet {
        width: 100%;
        max-width: 440px;
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }

      .login-brand-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.75rem;
      }

      .brand-monogram {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--admin-accent-gold), var(--admin-accent-gold-dark));
        color: #0b0f19;
        font-family: var(--admin-font-heading);
        font-weight: 900;
        font-size: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
      }

      .brand-meta .brand-name {
        display: block;
        font-family: var(--admin-font-heading);
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.05em;
        color: #ffffff;
      }

      .brand-meta .brand-scope {
        display: block;
        font-size: 0.78rem;
        color: var(--admin-text-muted);
      }

      .login-title {
        font-family: var(--admin-font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #ffffff;
      }

      .login-desc {
        font-size: 0.88rem;
        color: var(--admin-text-secondary);
        margin-bottom: 1.75rem;
        line-height: 1.6;
      }

      /* Alert Box */
      .alert-box {
        padding: 0.85rem 1.1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .alert-error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
      }

      .alert-success {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
      }

      /* Form Fields */
      .field-group {
        margin-bottom: 1.25rem;
      }

      .field-label {
        display: block;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--admin-text-secondary);
        margin-bottom: 0.4rem;
      }

      .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.4rem;
      }

      .text-action-btn {
        background: none;
        border: none;
        color: var(--admin-accent-gold);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
      }

      .field-input, .field-textarea, .field-select {
        width: 100%;
        background: var(--admin-bg-input);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #ffffff;
        font-family: inherit;
        font-size: 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .field-input:focus, .field-textarea:focus, .field-select:focus {
        outline: none;
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
      }

      .field-textarea {
        resize: vertical;
        min-height: 90px;
      }

      .field-hint {
        display: block;
        font-size: 0.76rem;
        color: var(--admin-text-muted);
        margin-top: 0.35rem;
      }

      /* Buttons */
      .btn-primary {
        background: var(--admin-accent-gold);
        color: #0b0f19;
        font-family: var(--admin-font-heading);
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 0.85rem 1.5rem;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: transform 0.15s ease, background-color 0.15s ease;
        text-decoration: none;
      }

      .btn-primary:hover {
        background: var(--admin-accent-gold-dark);
        transform: translateY(-1px);
      }

      .btn-secondary {
        background: var(--admin-bg-card);
        color: var(--admin-text-primary);
        font-family: var(--admin-font-heading);
        font-weight: 600;
        border: 1px solid var(--admin-border-subtle);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
        font-size: 0.85rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        transition: background-color 0.15s ease, border-color 0.15s ease;
        text-decoration: none;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--admin-accent-gold);
      }

      .btn-danger {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.15s ease;
      }

      .btn-danger:hover {
        background: rgba(239, 68, 68, 0.25);
      }

      .btn-block {
        width: 100%;
      }

      /* Admin Layout */
      .admin-layout {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar */
      .admin-sidebar {
        width: var(--admin-sidebar-width);
        background: var(--admin-bg-surface);
        border-right: 1px solid var(--admin-border-subtle);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 40;
        overflow-y: auto;
      }

      .sidebar-brand-box {
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--admin-border-subtle);
      }

      .sidebar-nav {
        padding: 1.25rem 0.75rem;
        flex: 1;
      }

      .nav-group-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--admin-text-muted);
        padding: 0.75rem 0.75rem 0.35rem;
      }

      .nav-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        background: none;
        border: none;
        color: var(--admin-text-secondary);
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        text-align: left;
        transition: background-color 0.15s ease, color 0.15s ease;
        margin-bottom: 2px;
      }

      .nav-item i {
        font-size: 1.1rem;
        color: var(--admin-text-muted);
        transition: color 0.15s ease;
      }

      .nav-item:hover {
        background: rgba(255, 255, 255, 0.04);
        color: #ffffff;
      }

      .nav-item:hover i {
        color: var(--admin-accent-gold);
      }

      .nav-item.active {
        background: var(--admin-accent-gold-soft);
        color: var(--admin-accent-gold);
        font-weight: 700;
      }

      .nav-item.active i {
        color: var(--admin-accent-gold);
      }

      .nav-count {
        margin-left: auto;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.15rem 0.45rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--admin-text-secondary);
      }

      .sidebar-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--admin-border-subtle);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--admin-accent-gold-soft);
        color: var(--admin-accent-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
      }

      .user-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: #ffffff;
        display: block;
      }

      .user-role {
        font-size: 0.7rem;
        color: var(--admin-text-muted);
        display: block;
      }

      .btn-logout {
        background: none;
        border: none;
        color: var(--admin-text-muted);
        font-size: 1.15rem;
        cursor: pointer;
        padding: 0.35rem;
        border-radius: 6px;
        transition: color 0.15s ease;
      }

      .btn-logout:hover {
        color: var(--admin-danger);
      }

      /* Main Workspace */
      .admin-main {
        margin-left: var(--admin-sidebar-width);
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      /* Header Bar */
      .admin-header {
        height: var(--admin-header-height);
        background: var(--admin-bg-surface);
        border-bottom: 1px solid var(--admin-border-subtle);
        position: sticky;
        top: 0;
        z-index: 30;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        backdrop-filter: blur(12px);
      }

      .header-title-box {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .section-heading-title {
        font-family: var(--admin-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
      }

      .mode-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .mode-local {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
      }

      .mode-remote {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.3);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .dirty-indicator {
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--admin-text-muted);
      }

      .dirty-indicator.unsaved {
        color: var(--admin-accent-gold);
      }

      .dirty-indicator .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--admin-text-muted);
      }

      .dirty-indicator.unsaved .pulse-dot {
        background: var(--admin-accent-gold);
        box-shadow: 0 0 8px rgba(245, 158, 11, 0.8);
      }

      /* Content Container */
      .admin-content {
        padding: 2.25rem;
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
        flex: 1;
      }

      /* Section Panels */
      .admin-panel {
        display: none;
      }

      .admin-panel.active {
        display: block;
        animation: fadeIn 0.2s ease;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .panel-card {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 14px;
        padding: 1.75rem 2rem;
        margin-bottom: 2rem;
      }

      .card-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--admin-border-subtle);
      }

      .card-title {
        font-family: var(--admin-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .card-title i {
        color: var(--admin-accent-gold);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }

      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
      }

      /* Photo Preview Box */
      .photo-preview-box {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        background: var(--admin-bg-input);
        padding: 1.25rem;
        border-radius: 10px;
        border: 1px solid var(--admin-border-subtle);
        margin-bottom: 1rem;
      }

      .preview-thumbnail {
        width: 90px;
        height: 110px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--admin-border-subtle);
        background: #000000;
      }

      .preview-meta {
        flex: 1;
      }

      .preview-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.25rem;
      }

      .preview-path {
        font-size: 0.78rem;
        color: var(--admin-text-muted);
        font-family: monospace;
        margin-bottom: 0.75rem;
        word-break: break-all;
      }

      /* Items List Manager */
      .items-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .item-row-card {
        background: var(--admin-bg-card);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 10px;
        padding: 1.25rem;
        transition: border-color 0.15s ease;
      }

      .item-row-card:hover {
        border-color: rgba(245, 158, 11, 0.3);
      }

      .item-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .item-index-badge {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--admin-accent-gold);
        background: var(--admin-accent-gold-soft);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
      }

      /* Toast Notifications */
      .toast-stack {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .toast-msg {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border-subtle);
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        font-size: 0.88rem;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 280px;
        animation: slideInRight 0.25s ease;
      }

      .toast-msg.success {
        border-color: rgba(16, 185, 129, 0.5);
      }

      .toast-msg.success i {
        color: var(--admin-success);
        font-size: 1.2rem;
      }

      .toast-msg.error {
        border-color: rgba(239, 68, 68, 0.5);
      }

      .toast-msg.error i {
        color: var(--admin-danger);
        font-size: 1.2rem;
      }

      @keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      /* Responsive */
      @media (max-width: 992px) {
        .admin-sidebar {
          transform: translateX(-100%);
          transition: transform 0.25s ease;
        }

        .admin-sidebar.open {
          transform: translateX(0);
        }

        .admin-main {
          margin-left: 0;
        }

        .grid-2, .grid-3, .grid-4 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body data-base-url={base}>
    <!-- Initial Server Content Payload -->
    <script type="application/json" id="initial-cms-payload" set:html={initialDataJson}></script>

    <!-- ==========================================
         1. LAYAR LOGIN KEAMANAN ADMIN
         ========================================== -->
    <main id="login-view" class="login-screen" aria-labelledby="login-heading">
      <div class="login-sheet">
        <div class="login-brand-row">
          <div class="brand-monogram" aria-hidden="true">N</div>
          <div class="brand-meta">
            <span class="brand-name">NURUL CMS</span>
            <span class="brand-scope">Manajemen Portofolio Profesional</span>
          </div>
        </div>

        <h1 id="login-heading" class="login-title">Masuk ke Panel Admin</h1>
        <p class="login-desc">
          Panel kontrol terproteksi untuk mengelola profil, galeri foto, rekam jejak acara, prestasi, dan pengaturan portofolio Nurul Ngaeni.
        </p>

        <div id="login-alert" class="alert-box alert-error" role="alert" style="display: none;"></div>

        <form id="login-form" class="login-form" novalidate>
          <div class="field-group">
            <label for="login-username" class="field-label">Username</label>
            <input
              type="text"
              id="login-username"
              name="username"
              class="field-input"
              autocomplete="username"
              placeholder="Masukkan username admin"
              required
            />
          </div>

          <div class="field-group">
            <div class="label-row">
              <label for="login-password" class="field-label">Password</label>
              <button
                type="button"
                id="toggle-password-btn"
                class="text-action-btn"
                aria-label="Tampilkan atau sembunyikan password"
              >
                Tampilkan
              </button>
            </div>
            <input
              type="password"
              id="login-password"
              name="password"
              class="field-input"
              autocomplete="current-password"
              placeholder="Masukkan password admin"
              required
            />
            <span class="field-hint">
              Otentikasi dilindungi enkripsi hash SHA-256 dan pembatasan percobaan brute-force.
            </span>
          </div>

          <button type="submit" id="submit-login-btn" class="btn-primary btn-block" style="margin-top: 1.5rem;">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Masuk ke Panel Kontrol</span>
          </button>
        </form>
      </div>
    </main>

    <!-- ==========================================
         2. WORKSPACE PANEL ADMIN
         ========================================== -->
    <div id="admin-view" class="admin-layout" style="display: none;">
      <!-- Sidebar Navigasi -->
      <aside class="admin-sidebar" aria-label="Sidebar Admin">
        <div class="sidebar-brand-box">
          <div class="brand-monogram" style="width: 36px; height: 36px; font-size: 1.1rem;">N</div>
          <div class="brand-meta">
            <span class="brand-name" style="font-size: 0.95rem;">NURUL CMS</span>
            <span class="brand-scope" style="font-size: 0.72rem;">Admin Dashboard v2.5</span>
          </div>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-group-label">Ikhtisar</div>
          <button type="button" class="nav-item active" data-section="overview">
