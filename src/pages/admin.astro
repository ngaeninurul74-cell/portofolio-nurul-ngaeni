      // About HTML
      function renderAbout() {
        const a = workingContent.about || {};
        const q = workingContent.quote || {};
        const cards = a.cards || [];
        return `
          <div class="panel-card">
            <h3 class="card-title" style="margin-bottom: 1.5rem;"><i class="bi bi-card-text"></i> Bagian Tentang Saya (Editorial Style)</h3>
            <div class="grid-2">
              <div class="field-group">
