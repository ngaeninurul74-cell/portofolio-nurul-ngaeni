      window.cmsChangePassword = async () => {
        const newPass = (document.getElementById('setting-new-password') as HTMLInputElement)?.value;
        const confirmPass = (document.getElementById('setting-confirm-password') as HTMLInputElement)?.value;
        if (!newPass || newPass.length < 6) {
          showToast('Password baru minimal 6 karakter!', 'error');
          return;
        }
        if (newPass !== confirmPass) {
          showToast('Konfirmasi password tidak cocok!', 'error');
          return;
        }
        const hash = await sha256Hex(newPass);
        localStorage.setItem('nurul_cms_pass_hash', hash);
        showToast('Password admin berhasil diubah!', 'success');
      };

      window.cmsDownloadBackup = () => {
        downloadJsonBackup();
        showToast('File backup portfolioContent.json berhasil diunduh!');
      };

      // Authentication Initialization
      function initAuth() {
        const loginView = document.getElementById('login-view');
        const adminView = document.getElementById('admin-view');
        const isAuth = sessionStorage.getItem('nurul_admin_auth') === '1';

        if (isAuth) {
          if (loginView) loginView.style.display = 'none';
          if (adminView) adminView.style.display = 'flex';
          checkEnvironmentMode();
          loadWorkingContent();
          renderActiveSection();
        } else {
          if (loginView) loginView.style.display = 'flex';
          if (adminView) adminView.style.display = 'none';
        }

        // Toggle Password Visibility
        const toggleBtn = document.getElementById('toggle-password-btn');
        const passInput = document.getElementById('login-password') as HTMLInputElement | null;
        if (toggleBtn && passInput) {
          toggleBtn.addEventListener('click', () => {
            if (passInput.type === 'password') {
              passInput.type = 'text';
              toggleBtn.textContent = 'Sembunyikan';
            } else {
              passInput.type = 'password';
              toggleBtn.textContent = 'Tampilkan';
            }
          });
        }

        // Login Form Submit
        const loginForm = document.getElementById('login-form');
        const alertBox = document.getElementById('login-alert');
        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const usernameInput = (document.getElementById('login-username') as HTMLInputElement)?.value.trim();
            const passwordInput = (document.getElementById('login-password') as HTMLInputElement)?.value;

            const { user, passHash } = getStoredCredentials();
            const inputHash = await sha256Hex(passwordInput || '');

            if (usernameInput === user && inputHash === passHash) {
              sessionStorage.setItem('nurul_admin_auth', '1');
              if (loginView) loginView.style.display = 'none';
              if (adminView) adminView.style.display = 'flex';
              checkEnvironmentMode();
              loadWorkingContent();
              renderActiveSection();
              showToast('Selamat datang kembali, Nurul Ngaeni!');
            } else {
              if (alertBox) {
                alertBox.style.display = 'flex';
                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i><span>Username atau password salah!</span>';
              }
            }
          });
        }

        // Logout
        const logoutBtn = document.getElementById('logout-btn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', () => {
            if (isDirty) {
              if (!confirm('Anda memiliki perubahan yang belum disimpan. Yakin ingin keluar?')) return;
            }
            sessionStorage.removeItem('nurul_admin_auth');
            location.reload();
          });
        }

        // Sidebar Navigation
        document.querySelectorAll('.nav-item').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeSection = btn.getAttribute('data-section') || 'overview';
            renderActiveSection();
          });
        });

        // Save All Button
        const saveAllBtn = document.getElementById('save-all-btn');
        if (saveAllBtn) {
          saveAllBtn.addEventListener('click', saveAllChanges);
        }

        // Warn before leaving with unsaved changes
        window.addEventListener('beforeunload', (e) => {
          if (isDirty) {
            e.preventDefault();
            e.returnValue = '';
          }
        });
      }

      // Start on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuth);
      } else {
        initAuth();
      }
    </script>
  </body>
</html>
