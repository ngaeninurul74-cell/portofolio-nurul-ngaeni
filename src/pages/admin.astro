      // 11. CONTACT & BOOKING
      function renderContact(container: HTMLElement) {
        const c = workingContent.contact || (workingContent.contact = {});
        const p = workingContent.personal || (workingContent.personal = {});
        const f = workingContent.footer || (workingContent.footer = {});

        const panel = document.createElement('section');
        panel.className = 'cms-panel';
        panel.innerHTML = `
          <div class="panel-header">
            <div>
              <h3 class="panel-title"><i class="bi bi-envelope-at"></i> Pengaturan Kontak &amp; Booking</h3>
              <p class="panel-desc">Tautan langsung WhatsApp, surel resmi, LinkedIn, dan foto penutup booking.</p>
            </div>
          </div>
        `;

        const closingPhotoRow = createPhotoRow(
          p.closingImageWebp || p.closingImage,
          () => {
            triggerImageUpload('landing_page_assets/hero', (path) => {
              p.closingImage = path;
              p.closingImageWebp = path;
              markDirty();
              renderContact(container);
            });
          },
          'Foto Penutup Booking (Closing Section Portrait)'
        );
        panel.appendChild(closingPhotoRow);

        const grid = document.createElement('div');
        grid.className = 'form-grid-2';
        grid.append(
          createInputField('Label Tag Bagian Kontak', c.tag, (v) => (c.tag = v)),
          createInputField('Judul Headline Booking', c.title, (v) => (c.title = v)),
          createTextareaField('Subteks Penjelasan Kolaborasi', c.subtitle, (v) => (c.subtitle = v), { rows: 2 }),
          createInputField('Nomor WhatsApp (Teks)', p.whatsapp, (v) => (p.whatsapp = v)),
          createInputField('Link Langsung WhatsApp', p.whatsappLink, (v) => (p.whatsappLink = v)),
          createInputField('Alamat Email Resmi', p.email, (v) => (p.email = v)),
          createInputField('URL Profil LinkedIn', p.linkedin, (v) => (p.linkedin = v))
        );
        panel.appendChild(grid);
        container.appendChild(panel);

        // Footer Settings Panel
        const footerPanel = document.createElement('section');
        footerPanel.className = 'cms-panel';
        footerPanel.innerHTML = `
          <div class="panel-header">
            <div>
              <h3 class="panel-title"><i class="bi bi-layout-text-window-reverse"></i> Footer Website</h3>
              <p class="panel-desc">Nama brand di bagian bawah dan teks hak cipta (copyright).</p>
            </div>
          </div>
        `;
        const fGrid = document.createElement('div');
        fGrid.className = 'form-grid-2';
        fGrid.append(
          createInputField('Nama Brand Footer', f.brandName, (v) => (f.brandName = v)),
          createInputField('Tagline Footer', f.tagline, (v) => (f.tagline = v)),
          createInputField('Teks Hak Cipta (Copyright)', f.copyright, (v) => (f.copyright = v), { fullWidth: true })
        );
        footerPanel.appendChild(fGrid);
        container.appendChild(footerPanel);
      }

      // 12. SETTINGS & BACKUP
      function renderSettings(container: HTMLElement) {
        const pat = localStorage.getItem('nurul_cms_github_pat') || '';
        const repo = localStorage.getItem('nurul_cms_github_repo') || 'ngaeninurul74-cell/portofolio-nurul-ngaeni';

        // Panel 1: Keamanan Password
        const passPanel = document.createElement('section');
        passPanel.className = 'cms-panel';
        passPanel.innerHTML = `
          <div class="panel-header">
            <div>
              <h3 class="panel-title"><i class="bi bi-shield-lock"></i> Ganti Password Akun Admin</h3>
              <p class="panel-desc">Perbarui password login admin yang disimpan terenkripsi dengan hash kriptografi SHA-256 di browser.</p>
            </div>
          </div>
          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label">Username Admin</label>
              <input type="text" id="setting-username" class="field-input" value="${getStoredCredentials().username}" />
            </div>
            <div class="field-group">
              <label class="field-label">Password Baru (Minimal 6 Karakter)</label>
              <input type="password" id="setting-new-pass" class="field-input" placeholder="Masukkan password baru" />
            </div>
            <div class="field-group col-span-full">
              <label class="field-label">Konfirmasi Password Baru</label>
              <input type="password" id="setting-confirm-pass" class="field-input" placeholder="Ketik ulang password baru" />
            </div>
          </div>
          <div style="margin-top: 1rem;">
            <button type="button" id="btn-save-pass" class="btn-primary">
              <i class="bi bi-key-fill"></i> Simpan Password Baru
            </button>
          </div>
        `;

        passPanel.querySelector('#btn-save-pass')?.addEventListener('click', async () => {
          const uInput = (passPanel.querySelector('#setting-username') as HTMLInputElement)?.value.trim();
          const pInput = (passPanel.querySelector('#setting-new-pass') as HTMLInputElement)?.value;
          const cInput = (passPanel.querySelector('#setting-confirm-pass') as HTMLInputElement)?.value;

          if (!uInput) {
            showToast('Username wajib diisi!', 'error');
            return;
          }
          if (!pInput || pInput.length < 6) {
            showToast('Password baru minimal 6 karakter!', 'error');
            return;
          }
          if (pInput !== cInput) {
            showToast('Konfirmasi password tidak cocok!', 'error');
            return;
          }

          const passwordHash = await sha256Hex(pInput);
          localStorage.setItem(STORAGE_AUTH_KEY, JSON.stringify({ username: uInput, passwordHash }));
          setSessionAuthenticated(uInput);
          showToast('Kredensial login admin berhasil diperbarui!', 'success');
        });
        container.appendChild(passPanel);

        // Panel 2: GitHub PAT Sync
        const ghPanel = document.createElement('section');
        ghPanel.className = 'cms-panel';
        ghPanel.innerHTML = `
          <div class="panel-header">
            <div>
              <h3 class="panel-title"><i class="bi bi-github"></i> Integrasi GitHub (Mode Produksi GitHub Pages)</h3>
              <p class="panel-desc">Saat website berjalan di hosting statis GitHub Pages, simpanan CMS dapat langsung di-commit ke repositori.</p>
            </div>
          </div>
          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label">GitHub Repository (owner/repo)</label>
              <input type="text" id="setting-gh-repo" class="field-input" value="${repo}" placeholder="username/repo" />
            </div>
            <div class="field-group">
              <label class="field-label">Personal Access Token (PAT)</label>
              <input type="password" id="setting-gh-pat" class="field-input" value="${pat}" placeholder="ghp_xxxxxxxxxxxx" />
            </div>
          </div>
          <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
            <button type="button" id="btn-save-gh" class="btn-primary">
              <i class="bi bi-check2-circle"></i> Simpan Pengaturan GitHub
            </button>
            <a href="https://github.com/settings/tokens/new?scopes=repo" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <i class="bi bi-box-arrow-up-right"></i> Buat Token PAT di GitHub
            </a>
          </div>
        `;

        ghPanel.querySelector('#btn-save-gh')?.addEventListener('click', () => {
          const r = (ghPanel.querySelector('#setting-gh-repo') as HTMLInputElement)?.value.trim();
          const p = (ghPanel.querySelector('#setting-gh-pat') as HTMLInputElement)?.value.trim();
          if (r) localStorage.setItem('nurul_cms_github_repo', r);
          if (p) localStorage.setItem('nurul_cms_github_pat', p);
          showToast('Pengaturan GitHub tersimpan aman di browser!', 'success');
        });
        container.appendChild(ghPanel);

        // Panel 3: Cadangan Data (Export / Import / Reset)
        const backupPanel = document.createElement('section');
        backupPanel.className = 'cms-panel';
        backupPanel.innerHTML = `
          <div class="panel-header">
            <div>
              <h3 class="panel-title"><i class="bi bi-database-check"></i> Cadangan &amp; Pemulihan Data (JSON)</h3>
              <p class="panel-desc">Unduh berkas portofolio atau pulihkan cadangan arsip JSON kapan saja.</p>
            </div>
          </div>
          <div style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
            <button type="button" id="btn-export-json" class="btn-secondary">
              <i class="bi bi-download"></i> Unduh Cadangan (portfolioContent.json)
            </button>
            <button type="button" id="btn-import-json" class="btn-secondary">
              <i class="bi bi-upload"></i> Pulihkan dari Berkas JSON
            </button>
            <button type="button" id="btn-factory-reset" class="btn-danger-plain">
              <i class="bi bi-arrow-counterclockwise"></i> Reset ke Konten Default Bawaan
            </button>
          </div>
        `;

        backupPanel.querySelector('#btn-export-json')?.addEventListener('click', downloadJsonBackup);
        backupPanel.querySelector('#btn-factory-reset')?.addEventListener('click', resetToDefaultContent);

        const importInput = document.getElementById('cms-json-import') as HTMLInputElement | null;
        backupPanel.querySelector('#btn-import-json')?.addEventListener('click', () => {
          if (!importInput) return;
          importInput.value = '';
          importInput.onchange = () => {
            const file = importInput.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
              try {
                const parsed = JSON.parse(String(e.target?.result || '{}'));
                if (!parsed || !parsed.personal) {
                  throw new Error('Format JSON tidak sesuai dengan skema portofolio.');
                }
                workingContent = parsed;
                markDirty();
                updateSidebarCounts();
                renderSettings(container);
                showToast('Cadangan JSON berhasil diimpor ke editor!', 'success');
              } catch (err: any) {
                showToast(`Gagal membaca berkas JSON: ${err?.message || err}`, 'error');
              }
            };
            reader.readAsText(file);
          };
          importInput.click();
        });

        container.appendChild(backupPanel);
      }

      // ==========================================
      // OTENTIKASI & INITIALISASI SISTEM
      // ==========================================
      function initAuth() {
        const loginView = document.getElementById('login-view');
        const adminView = document.getElementById('admin-view');

        const switchView = () => {
          if (isSessionAuthenticated()) {
            if (loginView) loginView.style.display = 'none';
            if (adminView) adminView.style.display = 'flex';
            checkEnvironmentMode();
            loadWorkingContent();
            renderActiveSection();
          } else {
            if (loginView) loginView.style.display = 'flex';
            if (adminView) adminView.style.display = 'none';
          }
        };

        // Toggle Password Visibility
        const toggleBtn = document.getElementById('toggle-password-btn');
        const passInput = document.getElementById('login-password') as HTMLInputElement | null;
        if (toggleBtn && passInput) {
          toggleBtn.addEventListener('click', () => {
            if (passInput.type === 'password') {
              passInput.type = 'text';
              toggleBtn.textContent = 'Sembunyikan';
            } else {
              passInput.type = 'password';
              toggleBtn.textContent = 'Tampilkan';
            }
          });
        }

        // Login Form Submission with Rate-Limiting Protection
        const loginForm = document.getElementById('login-form');
        const loginAlert = document.getElementById('login-alert');
        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (loginAlert) loginAlert.hidden = true;

            // Rate-limiting check
            const rateRaw = localStorage.getItem(STORAGE_RATE_KEY);
            const rate = rateRaw ? JSON.parse(rateRaw) : { count: 0, lockUntil: 0 };
            if (rate.lockUntil > Date.now()) {
              const waitSec = Math.ceil((rate.lockUntil - Date.now()) / 1000);
              if (loginAlert) {
                loginAlert.hidden = false;
                loginAlert.innerHTML = `<i class="bi bi-clock-history"></i><span>Terlalu banyak percobaan gagal. Silakan tunggu ${waitSec} detik lagi.</span>`;
              }
              return;
            }

            const usernameInput = (document.getElementById('login-username') as HTMLInputElement)?.value.trim();
            const passwordInput = (document.getElementById('login-password') as HTMLInputElement)?.value;

            if (!usernameInput || !passwordInput) {
              if (loginAlert) {
                loginAlert.hidden = false;
                loginAlert.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i><span>Username dan password wajib diisi.</span>';
              }
              return;
            }

            const creds = getStoredCredentials();
            const inputHash = await sha256Hex(passwordInput);

            if (usernameInput === creds.username && inputHash === creds.passwordHash) {
              localStorage.removeItem(STORAGE_RATE_KEY);
              setSessionAuthenticated(usernameInput);
              if (loginAlert) loginAlert.hidden = true;
              switchView();
              showToast('Selamat datang kembali di Panel Admin Portofolio!', 'success');
            } else {
              rate.count = (rate.count || 0) + 1;
              if (rate.count >= 5) {
                rate.lockUntil = Date.now() + 60000; // 60 seconds lockout
                rate.count = 0;
              }
              localStorage.setItem(STORAGE_RATE_KEY, JSON.stringify(rate));

              if (loginAlert) {
                loginAlert.hidden = false;
                loginAlert.innerHTML = `<i class="bi bi-shield-x"></i><span>Kredensial tidak valid. Percobaan gagal: ${rate.count}/5.</span>`;
              }
            }
          });
        }

        // Logout
        document.getElementById('logout-btn')?.addEventListener('click', () => {
          if (isDirty) {
            if (!confirm('Anda memiliki perubahan yang belum disimpan. Yakin ingin keluar?')) return;
          }
          sessionStorage.removeItem(SESSION_AUTH_KEY);
          location.reload();
        });

        // Sidebar Navigation
        document.querySelectorAll('.nav-item').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeSection = btn.getAttribute('data-section') || 'overview';
            renderActiveSection();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });

        // Save All Button
        document.getElementById('save-all-btn')?.addEventListener('click', saveAllChanges);

        // Beforeunload Warning
        window.addEventListener('beforeunload', (e) => {
          if (isDirty) {
            e.preventDefault();
            e.returnValue = '';
          }
        });

        // Initial view switch
        switchView();
      }

      // Initialize on DOM Ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuth);
      } else {
        initAuth();
      }
    </script>
  </body>
</html>
