---
// src/components/Services.astro
import { services } from '../data/portfolioData';
---

<section class="services-section" id="services">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">KOMPETENSI & LAYANAN</span>
      <h2 class="section-title">Bidang Keahlian Profesional</h2>
      <p class="section-desc">
        Keahlian komprehensif yang dirancang untuk memastikan kesuksesan agenda dan acara Anda.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <div class="service-icon"><i class={service.icon}></i></div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-text">{service.desc}</p>
          <ul class="service-checklist">
            {service.checklist.map((item) => (
              <li>
                <i class="bi bi-check2-circle"></i> {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
